{
  "_por_que": "Cada entrada es una defensa del muro en la ventanilla clínica. Si al quitarla el test sigue verde, esa defensa no está cubierta. Las de `--a` nacen del día en que `--a` podía truncar un original clínico; las de `listar` y `retirar`, de dos checks que pasaban en vacío.",
  "objetivo": "tools/lector_clinico.py",
  "test": ["python3", "tests/test_lector_clinico_binario.py"],
  "env": "BTP_LECTOR",
  "mutaciones": [
    {"etiqueta": "--a: sin es_ruta_clinica en el destino",
     "viejo": "    if not ZC.es_ruta_clinica(d):", "nuevo": "    if False:"},
    {"etiqueta": "--a: sin samefile/ya-existe (hardlink y sobrescritura)",
     "viejo": "    if os.path.lexists(d):", "nuevo": "    if False:"},
    {"etiqueta": "--a: sin islink en el destino",
     "viejo": "    if os.path.islink(d):\n        return None, \"el destino %s es un symlink; no se escribe a través de enlaces\" % d\n",
     "nuevo": ""},
    {"etiqueta": "--a: sin realpath del padre",
     "viejo": "    d = os.path.join(os.path.realpath(padre), os.path.basename(d))\n", "nuevo": ""},
    {"etiqueta": "--a: la copia nace en 0666", "viejo": "0o600)", "nuevo": "0o666)"},
    {"etiqueta": "binario: sin magias (%PDF, PNG, DICM…)",
     "viejo": "    if any(cabecera.startswith(m) for m in MAGIAS):\n        return True\n", "nuevo": ""},
    {"etiqueta": "log: sin saneado de saltos de línea",
     "viejo": "return str(x).replace", "nuevo": "return str(x); return str(x).replace"},
    {"etiqueta": "listar: sin es_ruta_clinica en --dir",
     "viejo": "            if not ZC.es_ruta_clinica(r):", "nuevo": "            if False:"},
    {"etiqueta": "listar: sin filtro de symlink de fichero",
     "viejo": "                if os.path.islink(ruta) and not ZC.es_ruta_clinica(os.path.realpath(ruta)):\n                    continue\n",
     "nuevo": ""},
    {"etiqueta": "listar: sin tope (--max ignorado)",
     "viejo": "                if len(hallados) >= tope:", "nuevo": "                if False:"},
    {"etiqueta": "listar: sin línea en el log",
     "viejo": "    _log(agent, \"LISTADO-%d\" % len(hallados), \"patrón=%s\" % (patron or \"*\"))\n",
     "nuevo": ""},
    {"etiqueta": "listar: busca con tildes (sin normalizar)",
     "viejo": "    n, p = ZC.normaliza(nombre), ZC.normaliza(patron)", "nuevo": "    n, p = nombre, patron"},
    {"etiqueta": "retirar: sin exigir --motivo",
     "viejo": "    if not (motivo or \"\").strip():", "nuevo": "    if False:"},
    {"etiqueta": "retirar: sin es_ruta_clinica en el origen",
     "viejo": "    if not ZC.es_ruta_clinica(origen):", "nuevo": "    if False:"},
    {"etiqueta": "retirar: machaca lo ya retirado",
     "viejo": "    if os.path.lexists(destino):", "nuevo": "    if False:"},
    {"etiqueta": "retirar: sin nota de retirada",
     "viejo": "        with open(destino + \".retirada.txt\", \"a\", encoding=\"utf-8\") as f:",
     "nuevo": "        with open(destino + \".otra.txt\", \"a\", encoding=\"utf-8\") as f:"},
    {"etiqueta": "retirar: BORRA en vez de mover",
     "viejo": "        os.rename(origen, destino)", "nuevo": "        os.remove(origen)"},
    {"etiqueta": "retirar: sin línea en el log",
     "viejo": "    _log(agent, \"RETIRADO\", \"%s -> %s (%s)\" % (origen, destino, motivo))\n",
     "nuevo": ""}
  ]
}
