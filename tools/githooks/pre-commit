#!/bin/sh
# tools/githooks/pre-commit — Fix (A) 11-jul-26 (radar `_cajita/radar-mejoras-10jul/C-guard-merge-master.md`).
# Gate BLANDO NATIVO de git: frena commits directos a la base (master/main) cuando la
# sesion no tiene el gate humano. Complementa (no sustituye) el gate software del muro
# (Fix c en `.claude/hooks/muro_guard.py`) — este hook actua incluso en sesiones
# --allow-dangerously-skip-permissions, que se saltan los hooks de Claude pero NO los de git.
#
# INERTE por defecto: solo actua si existe el MISMO toggle que activa el Fix (c),
# `.claude/hooks/.base_gate_on`. Sin el toggle, exit 0 inmediato — cero cambio de
# comportamiento hasta que alguien lo encienda a proposito.
#
# Defensivo: cualquier fallo al resolver el repo/la rama => exit 0 (nunca bloquear un
# commit legitimo por un fallo del propio hook).
#
# LIMITACION HONESTA: `git commit --no-verify` se salta este hook. Ver README.md.

toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$toplevel" ] || exit 0

toggle="$toplevel/.claude/hooks/.base_gate_on"
[ -f "$toggle" ] || exit 0

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || exit 0

case "$branch" in
    master|main) ;;
    *) exit 0 ;;
esac

if [ "$BTP_GIT_BASE_OK" = "1" ]; then
    exit 0
fi

echo "BLOQUEADO (git hook nativo, fix A 11-jul-26): commit directo a '$branch' sin gate." >&2
echo "Trabaja en una rama (git checkout -b ...), o exporta BTP_GIT_BASE_OK=1 con OK humano explicito." >&2
exit 1
