<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.dedup-hilos</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Dedup de hilos: pasada DETERMINISTA (sin tokens) que funde en seguimiento.json los hilos
       duplicados que generó la capa de información (triaje de correo, agenda HOY, planes) sin
       dedup-en-escritura. Invoca python directo, NO run_agent.sh. Corre tras el reconciliador (8:30). -->
  <key>ProgramArguments</key><array>
    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/dedup_hilos.py</string>
    <string>fix</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/dedup-hilos.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/dedup-hilos.err</string>
</dict></plist>
