<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.sync-playbook-nudge</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Fase 3: nudge de FRESCURA del playbook clínico. Una vez al día comprueba si el CONTENIDO
       de ESTADO-ACTUAL.md lleva > N días sin cambiar y, si es así, avisa a {{TITULAR}} por su canal
       (salida.report_to_titular → Telegram) para que lo refresque. NO autogenera nada clínico;
       solo recuerda. Anti-spam: como mucho un aviso al día.
       Se despliega en el MINI (24/7, canal Telegram fiable) con rutas /Users/polaris (sed en deploy).
       Umbral por defecto: 7 días (ajustable en el <string> de la opción nudge-frescura). -->
  <key>ProgramArguments</key><array>
    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/sync_playbook.py</string>
    <string>--nudge-frescura</string>
    <string>7</string>
    <string>--apply</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/sync-playbook-nudge.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/sync-playbook-nudge.err</string>
</dict></plist>
