<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.publicar-sync</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>BTP_REPO</key><string>/Users/polaris/claudecode</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/publicar_sync.py</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
  <!-- Dispara TAMBIÉN al moverse `master` en casa base: fusionar a base = cambio publicable.
       El calendario diario se queda como red de seguridad (si launchd perdiera un evento, o si
       el espejo quedara desfasado por un HALT levantado después). Se vigilan el ref suelto y su
       reflog: el ref puede acabar en `packed-refs` y dejar de tocarse, el reflog se escribe
       SIEMPRE. `publicar_sync.py` es idempotente (sin diff no hay commit ni push), así que un
       disparo de más no cuesta nada. `ThrottleInterval` de 120 s agrupa la ráfaga de un merge
       y evita derivar el árbol con casa base a medias. -->
  <key>WatchPaths</key><array>
    <string>/Users/polaris/claudecode/.git/refs/heads/master</string>
    <string>/Users/polaris/claudecode/.git/logs/refs/heads/master</string>
  </array>
  <key>ThrottleInterval</key><integer>120</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/publicar-sync.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/publicar-sync.err</string>
</dict></plist>
