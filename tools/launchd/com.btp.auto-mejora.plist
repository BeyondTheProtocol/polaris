<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BTP_AGENT</key>
		<string>auto-mejora</string>
		<key>BTP_AVISA_APLAZO</key>
		<string>1</string>
		<key>BTP_MAX_TURNS</key>
		<string>150</string>
		<key>BTP_MODEL</key>
		<string>opus</string>
		<key>BTP_SETTINGS</key>
		<string>settings.auto-mejora.json</string>
		<key>BTP_ORQUESTADOR</key>
		<string>claude-suscripcion</string>
		<key>BTP_RUTINA_NOMBRE</key>
		<string>la auto-mejora del sistema (la rutina que mejora tu gabinete cada día)</string>
		<key>MURO_PROFILE</key>
		<string>privileged</string>
		<key>PATH</key>
		<string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.btp.auto-mejora</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/polaris/claudecode/tools/run_agent.sh</string>
		<string>Ejecuta tu rutina diaria de auto-mejora.</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/polaris/claudecode/tools/launchd/logs/auto-mejora.err</string>
	<key>StandardOutPath</key>
	<string>/Users/polaris/claudecode/tools/launchd/logs/auto-mejora.out</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>8</integer>
			<key>Weekday</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>8</integer>
			<key>Weekday</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>8</integer>
			<key>Weekday</key>
			<integer>5</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>8</integer>
			<key>Weekday</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/polaris/claudecode</string>
</dict>
</plist>
