<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gateway del borde (F3): shim OpenAI-compatible en 127.0.0.1:8799 que enjaula al orquestador
     abierto (OpenCode/Goose). TODO egress pasa por ia.ask→borde (clasifica, bloquea sensible,
     sella). Solo LOOPBACK, sin claves de nube. stdlib (~0 tokens). KeepAlive: revive si se cae
     o tras reinicio. Encender = gate de {{TITULAR}} (btp_gateway.sh on). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.borde-gateway</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/polaris/claudecode/tools/borde_gateway.py</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/borde-gateway.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/borde-gateway.err</string>
</dict></plist>
