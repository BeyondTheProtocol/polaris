<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CHECK vivo del día (noche = cierre del día). Script DIRECTO (como enviar-hoy): determinista,
     gratis, NO pasa por run_agent ni por el saldo; 21:30 es antes del silencio nocturno (23-8).
     Activar = gate de {{TITULAR}}: launchctl bootstrap gui/$(id -u) este.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.parte-noche</string>
  <key>WorkingDirectory</key><string>/Users/titular/claudecode</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/titular/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>ProgramArguments</key><array><string>/Users/titular/claudecode/.venv/bin/python</string><string>/Users/titular/claudecode/tools/seguimiento.py</string><string>check</string><string>noche</string><string>--send</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/titular/claudecode/tools/launchd/logs/parte-noche.out</string>
  <key>StandardErrorPath</key><string>/Users/titular/claudecode/tools/launchd/logs/parte-noche.err</string>
</dict></plist>
