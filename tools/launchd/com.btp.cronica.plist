<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- El Cronista automático, CAPA 1: captura determinista diaria (sin LLM, egress-cero).
     Fin de día, 23:40. Recoge los eventos datables y los deja en la §Bitácora de CRONICA.md
     + registro máquina + estado para el Observatorio. PREPARADA SIN ACTIVAR. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.cronica</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/polaris/claudecode/tools/cronica.py</string>
    <string>capturar</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>40</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/cronica.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/cronica.err</string>
</dict></plist>
