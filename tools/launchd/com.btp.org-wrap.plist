<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ritual de VIERNES (patrón robado del "AI Chief of Staff" de Notion; la cadencia, no la plataforma).
     Cabos sueltos ABIERTOS de la semana (espera-a-terceros / bloqueado / con plazo) para cerrar o
     delegar antes del finde. DETERMINISTA, $0, sin LLM, solo-lectura sobre seguimiento.json; entrega
     por el canal gratis. NO contacta a nadie (muro). RunAtLoad false. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.org-wrap</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>BTP_STATE_DIR</key><string>/Users/polaris/claudecode/tools/state</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/rituales.py</string>
    <string>org-wrap</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/org-wrap.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/org-wrap.err</string>
</dict></plist>
