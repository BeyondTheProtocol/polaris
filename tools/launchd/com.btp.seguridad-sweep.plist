    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/seguridad_sweep_daemon.py</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
