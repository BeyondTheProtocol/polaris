<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Flusher de coalescencia de avisos "tarea nueva" (§3 del modelo unificado, {{TITULAR}} 2/7/26).
     DETERMINISTA, sin LLM, $0. Vacía tools/state/avisos/pendientes.jsonl en UN mensaje agrupado
     vía salida.report_to_titular (respeta HALT/silencio nocturno/anti-spam). CREADO, NO CARGADO:
     encenderlo es el gate de {{TITULAR}} (`launchctl bootstrap gui/$(id -u) este.plist`). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.avisos-flush</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/avisos_flush.py</string>
  </array>
  <key>StartInterval</key><integer>2700</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/avisos-flush.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/avisos-flush.err</string>
</dict></plist>
