<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- El parte diario del Observatorio a Telegram (REPORT a {{TITULAR}}; respeta HALT). A las 8:18.
     SUSTITUYE al ping de com.btp.polaris-estado (descárgalo al activar este, para no duplicar).
     Si la configuración llega a 100/100, usa salida.alerta_critica (aviso fuerte). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.observatorio-parte</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/polaris/claudecode/tools/observatorio.py</string>
    <string>parte</string>
    <string>--send</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>18</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/observatorio-parte.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/observatorio-parte.err</string>
</dict></plist>
