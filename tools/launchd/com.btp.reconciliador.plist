<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.reconciliador</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/polaris/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Reconciliador de estado: cose los almacenes satélite (reservas, cumbre, correo) contra la
       fuente única seguimiento.json. DETERMINISTA (sin tokens): invoca python directo, NO run_agent.sh.
       Cierra reservas resueltas 1:1 y propone lo demás a Vega. Corre tras la barrida de Vega (7:55). -->
  <key>ProgramArguments</key><array>
    <string>/Users/polaris/claudecode/.venv/bin/python</string>
    <string>/Users/polaris/claudecode/tools/reconciliar_estado.py</string>
    <string>fix</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/reconciliador.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/reconciliador.err</string>
</dict></plist>
