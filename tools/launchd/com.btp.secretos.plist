<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Broker de secretos (17-oct-2026, deuda llavero_bloqueado). Vive en gui/501, sesion Aqua:
     es donde el login.keychain se deja leer; por SSH sale bloqueado (rc=36). Lee con
     /usr/bin/security una lista CERRADA de claves (tools/secretos_broker.py PERMITIDAS) y la
     sirve por un socket Unix 0600 en tools/state/_secrets/broker.sock. Sin red, sin LLM. El log
     no lleva valores. KeepAlive: revive si se cae o tras reinicio (sirve en cuanto {{TITULAR}} entra
     en la sesion grafica). Encender = gate de {{TITULAR}}, SOLO con tools/activar_daemon.py desde
     casa base. Prueba por SSH, cierre de deudas y marcha atras: tools/launchd/SECRETOS.md. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.btp.secretos</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>WorkingDirectory</key><string>/Users/polaris/claudecode</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/polaris/claudecode/tools/secretos_broker.py</string>
    <string>servir</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/secretos.out</string>
  <key>StandardErrorPath</key><string>/Users/polaris/claudecode/tools/launchd/logs/secretos.err</string>
</dict></plist>
